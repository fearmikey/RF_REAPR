      "app/src/main/java/com/fearmikey/rf_reapr/data/db/entity/HidScriptEntity.kt",
      "app/src/main/java/com/fearmikey/rf_reapr/data/db/entity/HidAssetEntity.kt",
      "app/src/main/java/com/fearmikey/rf_reapr/data/db/entity/UsbDriveEntity.kt",
      "app/src/main/java/com/fearmikey/rf_reapr/data/db/entity/FindingEntity.kt (v17; unique (projectId, fingerprint); projectId '' = no project)"
    ],
    "v17_columns": "event_logs.projectId, scan_sessions.projectId (nullable, stamped by LogRepositoryImpl/ScanSessionRepositoryImpl from ActiveProjectStore); evidence_projects.scope (newline-separated, see ScopeMatcher)"
  },
  "feature_map": {
    "engagement_findings_scope": {
      "summary": "Evidence projects double as engagements. The active project (ActiveProjectStore -> ActiveEngagement singleton) tags logs, scan sessions and findings; its scope drives ScopeWarning under target inputs.",
      "routes": ["Screen.Engagement ('engagement')", "Screen.Findings ('findings')", "Screen.Backup ('backup')"],
      "ui": [
        "app/src/main/java/com/fearmikey/rf_reapr/ui/engagement/EngagementScreen.kt + EngagementViewModel.kt (project picker, scope editor, stats, exports, scan comparison)",
        "app/src/main/java/com/fearmikey/rf_reapr/ui/findings/FindingsScreen.kt + FindingsViewModel.kt (filter, triage status/notes, manual findings, export)",
        "app/src/main/java/com/fearmikey/rf_reapr/ui/menu/ActiveEngagementCard.kt (main menu banner)",
        "app/src/main/java/com/fearmikey/rf_reapr/ui/components/ScopeWarning.kt (used by Port Scanner, Ping, Traceroute, SNMP, TLS, Website Inspector, Subdomain Finder)",
        "app/src/main/java/com/fearmikey/rf_reapr/ui/components/ExportUtils.kt (ExportFormat, SAF text writer)"
      ],
      "state": [
        "app/src/main/java/com/fearmikey/rf_reapr/data/local/ActiveProjectStore.kt",
        "app/src/main/java/com/fearmikey/rf_reapr/domain/service/ActiveEngagement.kt"
      ],
      "repositories": [
        "app/src/main/java/com/fearmikey/rf_reapr/domain/repository/FindingRepository.kt -> data/repository/FindingRepositoryImpl.kt (mutex-serialized merge)",
        "app/src/main/java/com/fearmikey/rf_reapr/domain/repository/EngagementRepository.kt -> data/repository/EngagementRepositoryImpl.kt (stats, sessions, EngagementReport)"
      ],
      "domain": [
        "app/src/main/java/com/fearmikey/rf_reapr/domain/model/Finding.kt (Finding, FindingDraft, FindingStatus, FindingTools)",
        "app/src/main/java/com/fearmikey/rf_reapr/domain/service/FindingMerger.kt (fingerprint, dedupe, FIXED->OPEN regression)",
        "app/src/main/java/com/fearmikey/rf_reapr/domain/service/FindingAdapters.kt (tool results -> FindingDraft: ports, TLS, DNS audit, UPnP, SNMP, ARP, NFC, USB, cellular)",
        "app/src/main/java/com/fearmikey/rf_reapr/domain/service/ScopeMatcher.kt (CIDR/range/domain/wildcard/!exclusion, no DNS)",
        "app/src/main/java/com/fearmikey/rf_reapr/domain/service/FindingsExporter.kt (CSV w/ formula-injection guard, JSON, Markdown)",
        "app/src/main/java/com/fearmikey/rf_reapr/domain/service/ScanDiff.kt"
      ],
      "tool_wiring": "ViewModels take an optional findingRepository (PortScanner, UPnP, SNMP, TLS, DnsAuditor, NFC, ARP). UsbOtgAuditorScreen/CellularReconScreen take onFindings callbacks (recorded only when the finding set changes). New finding-producing tools: add an adapter in FindingAdapters with STABLE titles (titles are part of the fingerprint).",
      "tests": [
        "app/src/test/java/com/fearmikey/rf_reapr/domain/service/EngagementServicesTest.kt",
        "app/src/test/java/com/fearmikey/rf_reapr/domain/service/FindingAdaptersTest.kt"
      ]
    },
