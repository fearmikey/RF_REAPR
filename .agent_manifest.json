{
  "manifest_version": "1.0",
  "project_name": "RF-REAPR",
  "app_id": "com.fearmikey.rf_reapr",
  "instruction": "Before attempting any code modification, you must consult .agent_manifest.json to identify the architectural pattern and the specific files responsible for data flow. Do not guess file paths.",
  "maintenance_rule": "At the end of each development session, agents MUST update .agent_manifest.json if any new features, files, repositories, database models, or architectural components were added, modified, or removed.",
  "architectural_overview": {
    "pattern": "Unidirectional Data Flow (UDF) + MVVM (Model-View-ViewModel) + Repository Pattern + Clean Architecture",
    "dependency_injection": "Manual Dependency Injection in MainActivity.kt (Repositories instantiated on launch and injected into ViewModels via ViewModelProvider.Factory)",
    "ui_framework": "Jetpack Compose with Material 3",
    "async_concurrency": "Kotlin Coroutines & Flow / StateFlow",
    "persistence": "Room Database (AppDatabase v16, SQLite) + EncryptedSharedPreferences (SettingsRepositoryImpl)",
    "network": "Retrofit 2 + Gson + OkHttpClient for external APIs (Shodan, HIBP, NVD, etc.)",
    "background_processing": "WorkManager (VulnerabilityUpdateWorker, RecycleBinWorker) + ScanForegroundService (promotes scans to Android Foreground Service via ActiveTaskMonitor)",
    "native_code": "C++ / JNI iperf3 wrapper compiled via CMake with custom Android longjmp patch in app/src/main/cpp/iperf_android/",
    "foss_compliance": "Strict 100% FOSS. Zero proprietary SDKs (No Google Play Services/GMS, Ads, Billing, ML Kit, Firebase, or Analytics)."
  },
  "entry_points": {
    "application_class": "app/src/main/java/com/fearmikey/rf_reapr/RfReaprApplication.kt",
    "main_activity": "app/src/main/java/com/fearmikey/rf_reapr/MainActivity.kt",
    "navigation_routes": "app/src/main/java/com/fearmikey/rf_reapr/ui/navigation/Screen.kt",
    "database": "app/src/main/java/com/fearmikey/rf_reapr/data/db/AppDatabase.kt",
    "theme": "app/src/main/java/com/fearmikey/rf_reapr/ui/theme/Theme.kt"
  },
  "package_map": {
    "ui": "app/src/main/java/com/fearmikey/rf_reapr/ui/ (Jetpack Compose screens, ViewModels, Theme, Navigation)",
    "domain_models": "app/src/main/java/com/fearmikey/rf_reapr/domain/model/ (Core data structures & domain entities)",
    "domain_repositories": "app/src/main/java/com/fearmikey/rf_reapr/domain/repository/ (Interface definitions for data access)",
    "domain_services": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/ (ActiveTaskMonitor, DeviceIdentificationService)",
    "data_repositories": "app/src/main/java/com/fearmikey/rf_reapr/data/repository/ (Repository implementations)",
    "data_db": "app/src/main/java/com/fearmikey/rf_reapr/data/db/ (Room Database, Entities, DAOs, Converters)",
    "data_remote": "app/src/main/java/com/fearmikey/rf_reapr/data/remote/ (Retrofit API services & DTOs)",
    "data_local": "app/src/main/java/com/fearmikey/rf_reapr/data/local/ (SettingsRepositoryImpl & SharedPrefs)",
    "data_worker": "app/src/main/java/com/fearmikey/rf_reapr/data/worker/ (WorkManager Workers)",
    "system": "app/src/main/java/com/fearmikey/rf_reapr/system/ (Android Services, PCAP VPN, Root capture, Notifications)",
    "iperf": "app/src/main/java/com/fearmikey/rf_reapr/iperf/ (JNI wrapper & native iperf3 repository)",
    "util": "app/src/main/java/com/fearmikey/rf_reapr/util/ (AuditExporter, StegoEngine, ReportGraphRenderer)",
    "cpp_native": "app/src/main/cpp/ (iperf3 C++ submodule, iperf_android patches, CMakeLists.txt)"
  },
