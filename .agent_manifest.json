      "ui": "app/src/main/java/com/fearmikey/rf_reapr/ui/backup/BackupScreen.kt + BackupViewModel.kt (restart after restore)",
      "manager": "app/src/main/java/com/fearmikey/rf_reapr/data/backup/BackupManager.kt (WAL checkpoint snapshot, zip of db + filesDir + wol/engagement prefs, path rewrite on restore, zip-slip guard, newer-db-version rejection; excludes settings/API keys)",
      "crypto": "app/src/main/java/com/fearmikey/rf_reapr/data/backup/BackupCrypto.kt (PBKDF2-SHA256 310k + chunked AES-256-GCM with index/final-flag AAD)",
