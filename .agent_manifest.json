  "analysis_services": {
    "_note": "Pure-Kotlin analyzers in domain/service (no Android deps, unit-tested). Tools delegate parsing/scoring to these so the logic is testable. Added/expanded in the 2026 tool-enhancement pass.",
    "port_catalog": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/PortCatalog.kt (service names, exposure notes/risk, COMMON_PORTS, parsePortSpec, webUrl) - powers PortScanner (stateless scan(host,ports,options) in PortScannerRepository + banner grabbing in PortScannerRepositoryImpl)",
    "upnp": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/UpnpTools.kt (SSDP/description/SOAP/NAT-PMP parsing + findings) - UpnpScannerRepository.audit() reads IGD port mappings read-only; UpnpScannerViewModel/UpnpAuditorScreen",
    "dns_audit": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/DnsAuditEvaluator.kt (sentinel/NXDOMAIN/DNSSEC/rebinding checks, CheckStatus) - DnsAuditorRepositoryImpl gathers system vs DoH; DnsAuditorViewModel/Screen rewritten to a checklist",
    "captive_portal": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/CaptivePortalAnalyzer.kt - CaptivePortalViewModel (NetworkCapabilities + probe set); CaptivePortalDetectorScreen now takes a ViewModel",
    "snmp": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/SnmpTools.kt (ifType/speed, vendor from sysObjectID, default-community list, findings) - SnmpRepositoryImpl adds probeCommunity + walk + tables (interfaces/IP/ARP); SnmpViewModel/SnmpBrowserScreen tabbed",
    "arp": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/ArpMonitorEvaluator.kt (+ system/NeighborTable.kt) - ArpDetectorRepositoryImpl watches gateway MAC/first-hop/DNS/BSSID; notifies via NetworkAlertNotifier.notifySecurityAlert",
    "ble": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/BleAdvertisementAnalyzer.kt (tracker/beacon classification, distance) - BleScannerRepositoryImpl; BluetoothProximityFinderViewModel (trackers, following alerts, BLE session logs); model/BleDevice.kt enriched",
    "wifi": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/WifiSecurityAnalyzer.kt (security family, evil-twin, channel advice, band/channel math - NOTE 6GHz channel anchored at 5945MHz+1 per WifiAccessPointTest) - WifiFingerprintRepositoryImpl (status flow, ifXTable, standard); WifiFingerprintViewModel/Screen",
    "sdr": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/SdrDsp.kt (rtl_tcp header, Hann window, dBFS, peak) - RtlTcpRepositoryImpl (Hann+averaging, ~15fps, PPM/bias-T); FftData/SdrConfig enriched; WaterfallView spectrum+waterfall; SdrScreen",
    "nfc": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/NfcAnalyzer.kt (NDEF decode, chip ID, findings) - NfcScannerRepositoryImpl (reader-mode gated by screen via readerRequested); NfcTagData enriched; NfcScannerViewModel logs NFC",
    "magnetometer": "MagnetometerViewModel calibrated baseline/deviation + history + optional beep; MagnetometerRepository exposes accuracy/isAvailable",
    "usb": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/UsbAuditAnalyzer.kt (class names, attack-board VID:PID, BadUSB findings) - UsbOtgAuditorScreen polls deviceList",
    "cellular": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/CellAnalyzer.kt (LTE/NR band+freq, IMSI-catcher/2G-downgrade findings) - CellularReconScreen (requestCellInfoUpdate, all RATs)",
    "ducky": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/DuckyScriptValidator.kt (lint + duration estimate) - surfaced in HidInjectorScreen below the editor",
    "tls": "app/src/main/java/com/fearmikey/rf_reapr/domain/service/TlsAnalyzer.kt (protocol/cipher grading, overall grade, key/sig risk) - TlsCipherScannerRepositoryImpl (one handshake/protocol + cipher enumeration + certificate inspection); TlsScanResult/ProtocolSupport/CertificateInfo; also reused by CertDecoderScreen",
    "shared": "HostValidator.normalize is used by PortScanner, SNMP, TLS target parsing. SeverityBadge (ui/scanner) is the shared risk chip reused by UPnP/DNS/SNMP/USB/Cellular/TLS/NFC/Cert screens.",
    "tests": "app/src/test/java/com/fearmikey/rf_reapr/domain/service/{PortCatalog,UpnpTools,NetworkAuditEvaluators,WirelessAnalyzers,TlsAnalyzer}Test.kt (136 unit tests total pass)"
  }
}
